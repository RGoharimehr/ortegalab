# ─── LATFS Website — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in the values before running in production.
# None of these variables are required in development; sensible defaults apply.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # Set to "production" to enable secure cookies, etc.
BASE_URL=https://latfs.villanova.edu  # Used in password-reset emails and sitemap.xml

# ── Session ───────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# ── Seed account passwords ────────────────────────────────────────────────────
# Override the default passwords used when seeding the database for the first time.
# These are only read on initial database creation.
ADMIN_SEED_PASSWORD=changeme
LAB_SEED_PASSWORD=labpass

# ── Email (optional) ──────────────────────────────────────────────────────────
# Leave blank to disable email notifications entirely (safe for development).
SMTP_HOST=smtp.example.com
SMTP_PORT=587               # Use 465 for SSL, 587 for STARTTLS
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=latfs@villanova.edu
