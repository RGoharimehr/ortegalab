# Copy to .env for local development; npm start and npm run dev load it automatically.
# Use Node.js 22.13+ (22 or 24 LTS recommended).
NODE_ENV=development
PORT=3000
# Hetzner behind Nginx: 127.0.0.1. Containers require 0.0.0.0.
HOST=127.0.0.1
BASE_URL=http://localhost:3000

# Required in production. Keep stable across restarts so persistent sessions remain valid.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# New account passwords; changing these does not reset existing passwords.
# Production requires an explicit, unique admin seed password to create the first admin.
ADMIN_SEED_PASSWORD=
LAB_SEED_PASSWORD=

# Demo data is opt-in for local development only and is rejected in production.
# Existing records are preserved. Leave disabled for a real lab.
# SEED_DEMO_DATA=false

# Store both paths on durable storage in production. Native Node defaults are
# project-relative. Docker defaults: /app/data/latfs.db and /app/uploads.
# For a single Render disk mounted at /app/data, set BOTH values below.
# Keep existing deployment paths unless the existing data has been moved first.
# DATABASE_PATH=/app/data/latfs.db
# UPLOADS_PATH=/app/data/uploads

# Optional email. Leaving SMTP_HOST blank disables email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
