# ─── LATFS Website — Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in the values before running in production.
# None of these variables are required in development; sensible defaults apply.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # Set to "production" to enable secure cookies, etc.
BASE_URL=https://latfs.villanova.edu  # Used in password-reset emails and sitemap.xml

# ── Session ───────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-64-char-hex-string

# ── Seed account passwords ────────────────────────────────────────────────────
# Override the default passwords used when seeding the database for the first time.
# These are only read on initial database creation.
ADMIN_SEED_PASSWORD=changeme
LAB_SEED_PASSWORD=labpass

# ── Email (optional) ──────────────────────────────────────────────────────────
# Leave blank to disable email notifications entirely (safe for development).
# When configured, the following features send email:
#   • Password reset links (forgot password)
#   • Task assignment notifications
#   • Issue report notifications
#   • Low-stock inventory alerts (when qty drops below min_qty)
SMTP_HOST=smtp.example.com
SMTP_PORT=587               # Use 465 for SSL, 587 for STARTTLS
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=latfs@villanova.edu

# ── Database path (optional) ──────────────────────────────────────────────────
# Defaults to latfs.db in the project root. Override for Docker volume mounts.
# DATABASE_PATH=/data/latfs.db

# ── Advanced auth features (built-in — no config required) ───────────────────
# The following are enabled automatically and require no env vars:
#   • TOTP / 2FA  — users enroll at /platform → Profile → Enable 2FA
#   • Account lockout — accounts lock after 10 failed login attempts (auto-unlock after 30 min)
#   • Login audit log — every login attempt is recorded; admins can view at /api/admin/login-events
#   • Remember Me — users can opt for a 30-day session at login
#   • Last-login tracking — IP and timestamp of last successful login stored per user
